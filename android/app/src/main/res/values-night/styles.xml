<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">

        <!-- React Native default -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>

        <item name="colorPrimary">#171a20</item>
        <item name="colorPrimaryDark">#171a20</item>
        <item name="colorAccent">#F3BB2B</item>

        <item name="android:statusBarColor">#171a20</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#F3BB2B</item>
        <item name="android:autofilledHighlight">@android:color/transparent</item>
        <item name="android:datePickerDialogTheme">@style/CustomDatePickerTheme</item>
    </style>

    <style name="CustomDatePickerTheme" parent="Theme.AppCompat.Dialog">
        <item name="colorAccent">#FFFFFF</item>
        <item name="android:colorAccent">#FFFFFF</item>
    </style>

</resources>
